<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The metadata of the bundle of the application.

  What: the keys that the system of the operating system needs to run the
        application and to ask the user for the permission of the local network.
  Why: the application is a regular macOS app with a main window and a menu-bar
       status item (`DEC-076`, `MB-009`).
  Example: `NSLocalNetworkUsageDescription` explains why PhairDLNA needs local
          network access.

  The helper of the server is not part of this bundle: the server is
  installed as a `launchd` daemon by the command line, and the installation
  owns that decision (F-13, `M2.7`, the open question OD-04 of F-15).
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>PhairDLNA</string>
    <key>CFBundleDisplayName</key>
    <string>PhairDLNA</string>
    <key>CFBundleIdentifier</key>
    <string>org.phairdlna.phairdlna-mac</string>
    <key>CFBundleExecutable</key>
    <string>phairdlna-mac</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon-v2</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>PhairDLNA shows the state of the media server that runs on this computer.</string>
</dict>
</plist>
