# The messages of a failure.
error.surface_unreachable = Le serveur est inaccessible : {reason}. Démarrez-le via la ligne de commande.
error.surface_unreadable = Impossible de lire le serveur : {reason}. Veuillez réessayer dans un instant.
error.answer_invalid = La réponse du serveur n'est pas valide : {reason}.
error.answer_unexpected = La réponse du serveur est inattendue.
error.token_refused = Le jeton d'installation a été refusé. Vérifiez le fichier de jeton.
error.request_refused = Le serveur a refusé la requête : {status}.
error.token_unreadable = Le jeton d'installation ne peut être lu. Vérifiez le fichier de jeton.
error.server_not_started = Le serveur n'a jamais été démarré. Lancez-le via le terminal.
error.busy = Le serveur est occupé. Réessayez dans un instant.
error.scan_silent = La bibliothèque n'a pas été actualisée : le serveur n'a pas répondu.
error.cannot_open = Le système n'a pas pu ouvrir l'élément.
error.configuration_unreadable = La configuration ne peut pas être lue : {reason}
error.worker_not_started = Impossible de démarrer le service en arrière-plan : {reason}.
error.preference_failed = Impossible d'enregistrer la préférence : {reason}.

