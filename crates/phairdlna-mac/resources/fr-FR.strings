cli.help.token_file = --token-file <fichier> : le fichier contenant le jeton d'installation
cli.help.equivalent = Chaque action de cette application possède un équivalent dans phairdlna-cli
cli.error.unknown_option = Option inconnue : {option}
cli.error.missing_value = L'option {option} requiert une valeur
cli.error.bad_port = Le port {value} n'est pas un nombre compris entre 1 et 65535
cli.error.no_menu_bar = Aucune barre des menus disponible : {reason}
cli.error.not_main_thread = L'application n'a pas démarré sur le fil principal
cli.error.not_macos = Cette application nécessite macOS
