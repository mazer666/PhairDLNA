# The messages of a failure.
error.surface_unreachable = Der Server ist nicht erreichbar: {reason}. Starte den Server über die Befehlszeile.
error.surface_unreadable = Der Server kann nicht gelesen werden: {reason}. Bitte gleich noch einmal versuchen.
error.answer_invalid = Die Antwort des Servers ist ungültig: {reason}.
error.answer_unexpected = Die Antwort des Servers entspricht nicht den Erwartungen.
error.token_refused = Das Installationstoken wurde abgewiesen. Bitte Tokendatei prüfen.
error.request_refused = Der Server hat die Anfrage abgewiesen: {status}.
error.token_unreadable = Das Installationstoken kann nicht gelesen werden. Bitte Tokendatei prüfen.
error.server_not_started = Der Server wurde noch nie gestartet. Bitte über das Terminal starten.
error.busy = Der Server ist ausgelastet; bitte in einem Moment erneut versuchen.
error.scan_silent = Bibliothek wurde nicht aktualisiert: Der Server antwortete nicht.
error.cannot_open = Das System konnte das Objekt nicht öffnen.
error.configuration_unreadable = Die Konfiguration kann nicht gelesen werden: {reason}
error.worker_not_started = Der Hintergrunddienst konnte nicht gestartet werden: {reason}.
error.preference_failed = Die Einstellung konnte nicht gespeichert werden: {reason}.

